# Copy this file to .env and fill in the values.
#   cp .env.example .env
# .env is gitignored. NEVER commit a real key.

# ---------------------------------------------------------------------------
# Listings API (json-server in dev, MockAPI once deployed)
# ---------------------------------------------------------------------------
VITE_API_BASE=http://localhost:3001

# ---------------------------------------------------------------------------
# HDB resale transactions (read-only; powers the price check)
# ---------------------------------------------------------------------------
# Our own API on Render. Optional — this is already the default.
VITE_RESALE_API_BASE=https://hdb-resale-api-7xle.onrender.com

# ---------------------------------------------------------------------------
# AI assistant provider
# ---------------------------------------------------------------------------
# "mock"   -> scripted agent, no network, no key. The default. Always demo-safe.
# "openai" -> any OpenAI-compatible /chat/completions endpoint (see README).
VITE_AI_PROVIDER=mock

# Only needed when VITE_AI_PROVIDER=openai.
# NOTE: anything in a VITE_ variable is compiled into the public JS bundle and
# is readable by anyone who opens the deployed site. Use a spend-capped key you
# can rotate, or run Ollama locally where no key is needed at all.
VITE_AI_BASE_URL=http://localhost:11434/v1
VITE_AI_MODEL=llama3.1
VITE_AI_API_KEY=
